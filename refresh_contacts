#!/usr/bin/env bash

# The main entry point to pipeline. Exits early if any envrionment variables are missing.

REAL_PATH=$(perl -MCwd='abs_path' -e 'printf "%s", abs_path("'"$0"'")' | xargs dirname)
source $REAL_PATH/config

if [ ! -f "$REAL_PATH/.env" ]; then
	echo "Required $REAL_PATH/.env file missing." >&2
	exit 1
else
	source "$REAL_PATH/.env"
fi 

env_vars=(
	"SF_USER"
	"DONATIONS"
	"DONATION_EMAIL_IDX"
	"DONATION_NAME_IDX"
	"CONTACTS"
)

# Check all env variable exist
for env_var in "${env_vars[@]}"; do
	[[ ! -n "${!env_var}" ]] && echo "Valid $env_var env variable required." >&2 && exit 2
done

# Check specific indices point to valid files
for env_var in "${env_vars[@]:1}"; do
	[[ ! -f "${!env_var}" ]] && echo "$env_var not a valid file" >&2 && exit 3
done

while getopts 'u' arg; do
		case "$arg" in
			u)
				UPDATE=0
				;;
			* | ?)
				UPDATE=1
				;;
		esac
done

message=" Fetching all contact list components "
buffer_length=$(( (SPACING + 6 - ${#message}) / 2 ))
printf -v buffer "%${buffer_length}s"
printf "%s%s%s\n" "${buffer// /=}" "$message" "${buffer// /=}"

"$REAL_PATH/fetch_join_components" affiliations contacts accounts

message=" Rebuilding contact list  "
buffer_length=$(( (SPACING + 6 - ${#message}) / 2 ))
printf -v buffer "%${buffer_length}s"
printf "\n%s%s%s\n" "${buffer// /=}" "$message" "${buffer// /=}"

"$REAL_PATH/build_contact_list"

if [ ! $UPDATE ]; then exit 0; fi

message=" Updating indices  "
buffer_length=$(( (SPACING + 6 - ${#message}) / 2 ))
printf -v buffer "%${buffer_length}s"
printf "\n%s%s%s\n" "${buffer// /=}" "$message" "${buffer// /=}"

"$REAL_PATH/index_donations_update_sp"
